# ==============================================================================
# 🐝 BeeHost - Arquivo de Configuração de Credenciais (.env)
# ==============================================================================
# Copie este arquivo para .env e preencha com suas chaves reais:
#   cp .env.example .env
# ==============================================================================

# Porta do Servidor Backend
PORT=3001

# Chave Secreta do Painel de Administração
ADMIN_TOKEN=beehost123

# ==============================================================================
# 💳 Gateway de Pagamento PIX - Asaas (Passo E)
# ==============================================================================
# Crie sua conta em https://www.asaas.com ou sandbox em https://sandbox.asaas.com
# Em Integrações > Gerar Chave de API, cole o token abaixo:
ASAAS_API_KEY=sua_chave_asaas_aqui
ASAAS_AMBIENTE=sandbox   # Altere para 'producao' quando for vender de verdade

# ==============================================================================
# 📲 Alertas de WhatsApp - Evolution API (Passo D)
# ==============================================================================
# URL da sua instância da Evolution API (ex: http://localhost:8080 ou IP da VPS)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=beehost_chave_secreta_123
WHATSAPP_NUMERO_ALERTA=5511999999999
